# Copy to backend/.env and adjust. Never commit the real .env.

# ---- server (loopback only; anything else is refused) ----
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5000
JARVIS_DEBUG=false
# Comma-separated origins allowed to call the API (the frontend dev server).
JARVIS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- offline language model (Ollama) ----
JARVIS_LLM_ENABLED=true
JARVIS_LLM_URL=http://127.0.0.1:11434
JARVIS_LLM_MODEL=llama3.2:3b
JARVIS_LLM_TIMEOUT=90
# CPU threads for Ollama requests (default: half the logical CPUs, at most 8; more was slower on the dev laptop)
# JARVIS_LLM_THREADS=8

# Optional Ollama *vision* model used together with OCR to describe the screen
# (e.g. qwen2.5vl:3b or llava:7b — pull it first). Leave empty to describe from OCR text only.
# The screenshot is sent to it only when OCR finds fewer than 4 lines (images cost ~40 s+ on CPU).
# JARVIS_VISION_MODEL=

# ---- offline speech-to-text (faster-whisper) ----
# tiny.en (fastest) | base.en (default) | small.en (more accurate, slower)
JARVIS_STT_MODEL=base.en
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8

# ---- offline text-to-speech (Piper) ----
JARVIS_TTS_ENABLED=true
# Any Piper voice id, e.g. en_GB-alan-medium, en_US-ryan-high, en_US-lessac-medium
JARVIS_TTS_VOICE=en_GB-alan-medium
# Speaking speed multiplier (0.5 - 2.0)
JARVIS_TTS_RATE=1.0

# ---- files ----
# Folders JARVIS may search/open/move/trash. Separator: ":" on Linux, ";" on Windows.
# Default: Desktop, Downloads, Documents, Music, Pictures, Videos in your home folder.
# JARVIS_SEARCH_ROOTS=/home/you/Downloads:/home/you/Music
# JARVIS_DATA_DIR=   (logs + models; default ~/.local/share/jarvis or %APPDATA%\jarvis)

# ---- briefing (today's schedule + tech news) ----
# Spoken when the laptop wakes up from sleep or the screen is unlocked after 20 s or more.
JARVIS_BRIEFING_ON_WAKE=true
# Comma-separated https RSS/Atom feeds; default: Google News Technology, TechCrunch, The Verge, Ars Technica.
# JARVIS_NEWS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml

# ---- launcher (python launch.py) ----
# Port of the JARVIS page the launcher serves and opens (must match JARVIS_ALLOWED_ORIGINS).
# JARVIS_FRONTEND_PORT=8080

# ---- optional ----
# JARVIS_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# JSON file adding/overriding allow-listed apps, see jarvis.config.example.json
# JARVIS_CONFIG_FILE=./jarvis.config.json
